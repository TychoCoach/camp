# ---------------------------------------------------------------------------
# Tycho Coaching Camps — Calpe
# Copy to `.env.local` and fill in. Every value below is OPTIONAL: with none of
# them set the site builds and runs, and the interest form falls back to the
# documented mailto flow (see README → "De interesselijst aansluiten").
# ---------------------------------------------------------------------------

# Public base URL, used for canonical + Open Graph URLs.
# Leave unset on a Vercel preview: the preview URL is detected automatically.
# Example: https://camps.tychocoaching.com
NEXT_PUBLIC_SITE_URL=

# Waitlist endpoint. UNSET = no backend connected: the form uses the mailto
# fallback and never claims a submission was stored.
# Set this to a real endpoint (Formspree, Resend proxy, ConvertKit, /api/waitlist)
# to switch the form to a real POST. See README for provider-specific notes.
# Example: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Address used by the mailto fallback and shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=tychocoach@gmail.com

# Set to "true" only when this deployment should be indexed by search engines.
# Previews must stay "false" so the pilot page does not get indexed early.
NEXT_PUBLIC_ALLOW_INDEXING=false
